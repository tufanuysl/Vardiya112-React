{
  "entities": {
    "AuthorizedAdmin": {
      "title": "AuthorizedAdmin",
      "description": "Ana Yönetici tarafından kurum vardiya, izin, icap ve personel verisi girmeye yetkilendirilmiş kurum admini kaydı.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Yetkilendirilen adminin Google e-posta adresi (küçük harf)",
          "minLength": 5,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "description": "Yetkili adminin adı soyadı / unvanı",
          "minLength": 2,
          "maxLength": 100
        },
        "institutionType": {
          "type": "string",
          "description": "Yetkili olduğu kurum kategorisi (ALL veya belirli bir kurum tipi)",
          "enum": ["ALL", "CAGRI_ALICI", "POLIS", "JANDARMA", "ITFAIYE", "SAGLIK_112", "AFAD", "ORMAN", "DIGER"],
          "minLength": 2,
          "maxLength": 30
        },
        "unitCode": {
          "type": "string",
          "description": "Varsa yetkili olduğu kurum kodu",
          "minLength": 0,
          "maxLength": 40
        },
        "addedByEmail": {
          "type": "string",
          "description": "Yetkiyi veren Ana Yöneticinin e-posta adresi",
          "minLength": 5,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Oluşturulma zamanı"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Güncellenme zamanı"
        }
      },
      "required": [
        "email",
        "name",
        "institutionType",
        "unitCode",
        "addedByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "InstitutionUnit": {
      "title": "InstitutionUnit",
      "description": "Bir kurum biriminin (Çağrı Alıcı, Polis, Jandarma, İtfaiye, 112 Sağlık, AFAD vb.) yayınlanmış vardiya sistemi, grup isimleri, personel listesi ve referans nöbet çizelgesi.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Birim adı (örn. Manisa 112 Çağrı Alıcı, Emniyet Haber Merkezi)",
          "minLength": 2,
          "maxLength": 100
        },
        "institutionType": {
          "type": "string",
          "description": "Kurum kategorisi",
          "enum": ["CAGRI_ALICI", "POLIS", "JANDARMA", "ITFAIYE", "SAGLIK_112", "AFAD", "ORMAN", "DIGER"],
          "minLength": 2,
          "maxLength": 30
        },
        "city": {
          "type": "string",
          "description": "İl adı",
          "minLength": 2,
          "maxLength": 50
        },
        "unitCode": {
          "type": "string",
          "description": "Personelin birime bağlanması için kurum kodu (örn. MANISA-112)",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Kurumu oluşturan büro sorumlusunun / yöneticinin Firebase Auth UID değeri",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerName": {
          "type": "string",
          "description": "Büro sorumlusu / yönetici adı soyadı",
          "minLength": 1,
          "maxLength": 100
        },
        "adminUids": {
          "type": "array",
          "description": "Bu kurumun verisini düzenlemeye yetkili büro personeli UID listesi (en fazla 10 kişi)"
        },
        "numGroups": {
          "type": "number",
          "description": "Grup sayısı (2-10)"
        },
        "is24HourSystem": {
          "type": "boolean",
          "description": "24 saat nöbet sistemi mi?"
        },
        "dayStart": {
          "type": "string",
          "description": "Gündüz vardiya başlangıç saati (SS:DD)",
          "minLength": 5,
          "maxLength": 5
        },
        "dayEnd": {
          "type": "string",
          "description": "Gündüz vardiya bitiş saati (SS:DD)",
          "minLength": 5,
          "maxLength": 5
        },
        "nightStart": {
          "type": "string",
          "description": "Gece vardiya başlangıç saati (SS:DD)",
          "minLength": 5,
          "maxLength": 5
        },
        "nightEnd": {
          "type": "string",
          "description": "Gece vardiya bitiş saati (SS:DD)",
          "minLength": 5,
          "maxLength": 5
        },
        "shift24Start": {
          "type": "string",
          "description": "24 saat vardiya başlangıç saati (SS:DD)",
          "minLength": 5,
          "maxLength": 5
        },
        "restHours": {
          "type": "number",
          "description": "Varsayılan istirahat süresi (saat)"
        },
        "dayRestHours": {
          "type": "number",
          "description": "Gündüz nöbeti sonrası istirahat süresi (saat)"
        },
        "nightRestHours": {
          "type": "number",
          "description": "Gece nöbeti sonrası istirahat süresi (saat)"
        },
        "shiftTransition": {
          "type": "string",
          "description": "Vardiya geçiş tipi (ALTERNATE veya SAME)",
          "enum": ["ALTERNATE", "SAME"],
          "minLength": 4,
          "maxLength": 12
        },
        "groupCycleMode": {
          "type": "string",
          "description": "Grup döngü modu (112_CLASSIC veya SEQUENTIAL)",
          "enum": ["112_CLASSIC", "SEQUENTIAL"],
          "minLength": 10,
          "maxLength": 15
        },
        "groupNames": {
          "type": "array",
          "description": "Grup adları dizisi (en fazla 10 grup)"
        },
        "groupMembers": {
          "type": "array",
          "description": "Her grubun virgülle ayrılmış personel isim listesi (en fazla 10 grup, ilk sıradaki Grup Sorumlusu, ikinci sıradaki Grup Sorumlusu Yardımcısı)"
        },
        "refDate": {
          "type": "string",
          "description": "Aktif referans nöbet tarihi (YYYY-MM-DD)",
          "minLength": 10,
          "maxLength": 10
        },
        "refGroupIdx": {
          "type": "number",
          "description": "Referans tarihte nöbetçi olan grup indeksi (0 tabanlı)"
        },
        "refType": {
          "type": "string",
          "description": "Referans nöbet tipi (GUNDUZ veya AKSAM)",
          "enum": ["GUNDUZ", "AKSAM"],
          "minLength": 5,
          "maxLength": 6
        },
        "announcement": {
          "type": "string",
          "description": "Büro personeli tarafından yayınlanan kurum duyurusu veya aylık not",
          "minLength": 0,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Oluşturulma zamanı (Sunucu zaman damgası)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Son güncellenme zamanı (Sunucu zaman damgası)"
        }
      },
      "required": [
        "name",
        "institutionType",
        "city",
        "unitCode",
        "ownerUid",
        "ownerName",
        "adminUids",
        "numGroups",
        "is24HourSystem",
        "dayStart",
        "dayEnd",
        "nightStart",
        "nightEnd",
        "shift24Start",
        "restHours",
        "dayRestHours",
        "nightRestHours",
        "shiftTransition",
        "groupCycleMode",
        "groupNames",
        "groupMembers",
        "refDate",
        "refGroupIdx",
        "refType",
        "announcement",
        "createdAt",
        "updatedAt"
      ]
    },
    "UnitRosterNote": {
