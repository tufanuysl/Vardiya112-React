{
  "appId": "com.tufanuysal.vardiya112",
  "appName": "Vardiya 112",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "cleartext": true,
    "allowNavigation": [
